<Window x:Class="AppClient.AutorisationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AppClient"
        mc:Ignorable="d"
        Title="Авторизация"
        WindowStartupLocation="CenterScreen"
        Height="450"
        Width="800">

    <Viewbox>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,395,0">
                <StackPanel Orientation="Horizontal">
                    <Image Source="/Images/logo.jpg" 
                       Width="40"
                       Margin="10,10,0,0"/>
                    <TextBlock Text="CORPMESS" 
                           FontSize="20" 
                         FontWeight="Bold"
                         HorizontalAlignment="Left"
                         Margin="10,15,0,5"/>
                </StackPanel>

                <!-- Заголовок -->
                <TextBlock Text="Добро пожаловать" 
                       FontSize="20" 
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       Margin="0,20,0,5"/>

                <TextBlock Text="на корпоративный портал!" 
                       FontWeight="Bold"
                       FontSize="20"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,30"/>
                <Image Height="230" 
                   Margin="20"
                   Source="/Images/fon.png"/>

            </StackPanel>

            <StackPanel Background="#E9EBD0" Margin="339,0,0,0">
                <Border Margin="10" CornerRadius="5" 
                Background="#E9EBD0" 
                BorderThickness="1" 
                BorderBrush="#E9EBD0"
                Width="350"
                Height="400"
                VerticalAlignment="Center"
                HorizontalAlignment="Center">

                    <StackPanel Margin="20,0,20,0" VerticalAlignment="Center" Height="313">

                        <!-- Заголовок авторизации -->
                        <TextBlock Text="Авторизация" 
                           FontSize="18" 
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,15"/>

                        <!-- Подзаголовок -->
                        <TextBlock Text="Авторизуйтесь в системе, чтобы получить доступ к порталу" 
                           FontSize="12"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,20"
                           TextWrapping="Wrap"
                           TextAlignment="Center"/>

                        <!-- Поля ввода -->
                        <StackPanel Margin="0,0,0,15">
                            <TextBox Style="{StaticResource placeHolder}" Tag="Login" x:Name="LoginTxb"
                                     Height="25" Width="250"
                                     Margin="0,0,0,10" Padding="0,2,0,0" 
                                     TextWrapping="Wrap" 
                                     VerticalAlignment="Top"/>

                            <PasswordBox x:Name="Passbx"
                                         Width="250"
                                         Height="25"/>
                        </StackPanel>

                        <!-- Чекбокс "Запомнить меня" -->
                        <CheckBox x:Name="RememberCheckBox" 
                          Content="Запомнить меня на этом компьютере"                          
                          Margin="5,0,0,20" Width="234"/>

                        <!-- Кнопки -->
                        <Button x:Name="LoginButton" 
                        Content="Войти" 
                        Background="#445859" 
                        Foreground="White"
                        FontWeight="Bold"
                            Width="150"
                        Height="35"
                        BorderThickness="0"
                        Margin="0,0,0,10"
                        Command="{Binding LoginCommand}"
                                Click="LoginButton_Click"/>

                        <Button x:Name="RegisrtButton" 
                        Content="Регистрация" 
                        Background="#445859" 
                        Foreground="White"
                        FontWeight="Bold"
                        Height="35"
                            Width="150"
                        BorderThickness="0"
                        Margin="0,0,0,0"
                                Click="RegisrtButton_Click"/>
                        <!--Command="{Binding RegisterCommand}"-->

                        <!-- Футер -->
                        <TextBlock Text="© Kir, 2025. Собственная разработка для диплома." 
                           FontSize="10"
                           HorizontalAlignment="Center"
                           Margin="0,15,0,0"
                           Foreground="#757575"/>
                    </StackPanel>
                </Border>
            </StackPanel>

        </Grid>
    </Viewbox>
</Window>
