<Page x:Class="AppClient.Views.ChatClient.ChatPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:AppClient.Views.ChatClient"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ChatPage">

    <Page.Resources>
        <!-- Стиль для текстового поля с подсказкой -->
        <Style x:Key="HintTextBoxStyle" TargetType="TextBox">
            <Setter Property="Foreground" Value="#7F7F7F"/>
            <Setter Property="FontStyle" Value="Italic"/>
            <Setter Property="Background" Value="#F5F5F5"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border" 
                        CornerRadius="15"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost" 
                                  Margin="{TemplateBinding Padding}"
                                  Focusable="False"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="Background" Value="White"/>
                                <Setter Property="Foreground" Value="Black"/>
                                <Setter Property="FontStyle" Value="Normal"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль для сообщения -->
        <Style x:Key="MessageStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="12,7,7,1"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="10,5,10,5"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <!--Стиль для тени у сообщений-->
                    <DropShadowEffect ShadowDepth="5" Opacity="0.4" BlurRadius="10" Direction="270"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Анимация появления сообщения -->
        <Storyboard x:Key="MessageAppearAnimation">
            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                     From="0" To="1" Duration="0:0:0.3"/>
            <ThicknessAnimation Storyboard.TargetProperty="Margin"
                       From="10,20,10,5" To="10,5,10,5" 
                       Duration="0:0:0.3"/>
        </Storyboard>
    </Page.Resources>

    <Grid Background="#F2F4F6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Шапка группы -->
        <Border Grid.Row="0" Background="White" Padding="15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="220"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <!-- Аватар группы -->
                    <Ellipse Width="36" Height="36" Grid.Column="0" Margin="0,0,10,0">
                        <Ellipse.Fill>
                            <ImageBrush ImageSource="{Binding Avatar}"/>
                        </Ellipse.Fill>
                    </Ellipse>
                    <StackPanel>
                        <TextBlock Text="Группа 1" 
                                   Foreground="Black" 
                                   FontSize="18" 
                                   FontWeight="SemiBold"/>
                        <TextBlock Text="4 участника" 
                                   Foreground="Black" 
                                   FontSize="13"
                                   Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>
                
                <StackPanel Orientation="Horizontal" Grid.Column="1">
                    <Button Content="Кнопка добавления" Margin="0,0,10,0"/>
                    <Button Content="Настройки чата"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Область сообщений -->
        <ListBox Grid.Row="1" x:Name="MessagesList" Background="#E9EBD0" BorderThickness="0"
             ScrollViewer.VerticalScrollBarVisibility="Hidden"
             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource MessageStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Аватар -->
                            <Ellipse Width="36" Height="36" Grid.Column="0" Margin="0,0,10,0">
                                <Ellipse.Fill>
                                    <ImageBrush ImageSource="{Binding Avatar}"/>
                                </Ellipse.Fill>
                            </Ellipse>

                            <!-- Текст сообщения -->
                            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                <TextBlock Text="{Binding Sender}" 
                                           FontWeight="SemiBold"
                                           Foreground="#333333"/>
                                <TextBlock Text="{Binding Text}" 
                                           Margin="0,5,0,0"
                                           Foreground="#555555"
                                           TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding Time}" 
                                           HorizontalAlignment="Right" 
                                           Foreground="#999999" 
                                           FontSize="11"
                                           Margin="0,5,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Поле ввода сообщения -->
        <Border Grid.Row="2" Padding="10" Background="#E9EBD0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="MessageTextBox" 
                     Text="Написать сообщение..." 
                     
                     Style="{StaticResource HintTextBoxStyle}"
                     GotFocus="MessageTextBox_GotFocus"
                     LostFocus="MessageTextBox_LostFocus"/>

                <Button Grid.Column="1"
                        Width="50"
                        Height="50"
                        Margin="10,0,0,0"
                        Content="Файл"/>

                <Button Grid.Column="2" 
                    x:Name="SendButton"
                    Content="Отправить" 
                    Margin="10,0,0,0" 
                    Padding="15,8"
                    Width="100"
                    Height="50"
                    Background="#91AAAB"
                    Foreground="White"
                    BorderThickness="0"
                    Click="SendButton_Click"
                    Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border CornerRadius="10" 
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}">
                                <ContentPresenter HorizontalAlignment="Center" 
                              VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                    <Button.Triggers>
                        <EventTrigger RoutedEvent="Button.Click">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                 From="0.5" To="1" Duration="0:0:0.2"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Button.Triggers>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Page>
