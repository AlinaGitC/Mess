<Page x:Class="AppClient.Views.MainClientPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:AppClient.Views"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"      
      Title="MainClientPage" Background="White">
    <!--<Viewbox>-->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

        <!-- Левая боковая панель -->
        <Grid Grid.Column="0" Background="#445859">
            <Grid.RowDefinitions>
                <RowDefinition Height="73"/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <!-- Иконка меню профиля-->
            <StackPanel Grid.Row="0">
                <Border BorderBrush="Black" BorderThickness="0,0,0,1" Height="73">
                    <Button x:Name="SettingProfileButton"
                        Height="50"
                        Width="60"/>
                </Border>
            </StackPanel>
            
            <!-- Список групп -->
            <StackPanel Grid.Row="1">
                <StackPanel Width="100" Height="90" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Button Height="50"
                            Width="50"
                            Margin="0,10,0,5"
                            Background="#E9EBD0"/>
                    <TextBlock Text="Название" 
                               Foreground="#E9EBD0"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- Средняя панель -->
        <Border Grid.Column="1" BorderBrush="#BE5C38" BorderThickness="0,0,1,0">
            <Grid >

                <Grid.RowDefinitions>
                    <RowDefinition Height="73"/>
                    <RowDefinition/>
                </Grid.RowDefinitions>

                <!-- Поисковая строка -->
                <TextBox x:Name="SearchTxb"
                         Style="{StaticResource SearchTextBoxStyle}"/>

                <!-- Вывод групп -->
                <Frame Grid.Row="1" x:Name="FrameChats" NavigationUIVisibility="Hidden"/>
            </Grid>
        </Border>

        <!-- Првая боковая панель -->
        <Grid Grid.Column="2">
            <Frame x:Name="ChatFrame" NavigationUIVisibility="Hidden" Background="#E9EBD0"/>
        </Grid>
            
        </Grid>
    <!--</Viewbox>-->
</Page>
